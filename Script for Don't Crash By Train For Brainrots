    btn.Size = size or UDim2.new(0.48, 0, 0, 50)
    btn.Position = pos
    btn.BackgroundColor3 = color or Color3.fromRGB(255, 100, 0)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
