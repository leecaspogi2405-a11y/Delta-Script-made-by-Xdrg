--========= CORE =========--
local function hrp() local c=LP.Character if not c then return nil end return c:FindFirstChild("HumanoidRootPart") end
local function eggPos(e)
    if e:IsA("Model") then
        if e.PrimaryPart then return e.PrimaryPart.Position end
        local p=e:FindFirstChildWhichIsA("BasePart") if p then return p.Position end
    elseif e:IsA("BasePart") then return e.Position end
    return nil
end
local function findCarryPrompt(e)
    for _,d in ipairs(e:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Name=="CarryAreaEgg" then return d end
    end
    for _,d in ipairs(e:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
    return nil
end
local function allEggs()
    local list={}
    local f=workspace:FindFirstChild("Eggs")
    if f then for _,v in ipairs(f:GetChildren()) do list[#list+1]=v end end
    if #list==0 then
        for _,v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and v.Name:lower():find("egg") then list[#list+1]=v end
        end
    end
    return list
end
local function isSel(n)
    if next(Selected)==nil then return true end
    for s,_ in pairs(Selected) do
        if n==s or n:find(s,1,true) or s:find(n,1,true) then return true end
    end
    return false
end
local function farthestEgg()
    local h=hrp() if not h then return nil end
    local best,bd=nil,-1
    for _,e in ipairs(allEggs()) do
        if isSel(e.Name) then
            local p=eggPos(e)
            if p then
                local d=(p-h.Position).Magnitude
                if d>bd then bd=d best=e end
            end
        end
    end
    return best
end
local function playerBase()
    if BasePos then return BasePos end
    for _,pn in ipairs({"Plot","Plots","Base","Bases","Pen","Pens","Farm","Farms"}) do
        local f=workspace:FindFirstChild(pn)
        if f then
            for _,c in ipairs(f:GetChildren()) do
                if c.Name:lower():find(LP.Name:lower(),1,true) or c.Name:lower():find(LP.DisplayName:lower(),1,true) then
                    if c:IsA("BasePart") then return c.Position end
                    if c:IsA("Model") and c.PrimaryPart then return c.PrimaryPart.Position end
                end
            end
        end
    end
    for _,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("SpawnLocation") then return v.Position end
    end
    return nil
end
local function dropPrompt()
    for _,d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local n=d.Name:lower()
            if n:find("drop") or n:find("place") or n:find("hatch") or n:find("store") then return d end
        end
    end
    return nil
end

-- Fly
local FlyBV = nil
local function stopFly() if FlyBV then FlyBV:Destroy() FlyBV=nil end end
local function flyTo(pos, timeout)
    local h=hrp() if not h then return end
    timeout=timeout or 15
    stopFly()
    local bv=Instance.new("BodyVelocity")
    bv.Name="XdrgAutoFly" bv.MaxForce=Vector3.new(1e5,1e5,1e5) bv.Velocity=Vector3.zero bv.Parent=h
    FlyBV=bv
    local t0=tick()
    while FlyBV==bv and h.Parent and (tick()-t0)<timeout do
        local d=pos-h.Position
        if d.Magnitude<8 then bv.Velocity=Vector3.zero break end
        local sp=430
        if d.Magnitude<30 then sp=math.max(40,d.Magnitude*14) end
        bv.Velocity=d.Unit*sp
        RunService.Heartbeat:Wait()
    end
    if bv then bv:Destroy() end
    if FlyBV==bv then FlyBV=nil end
end

-- Auto Steal Cycle
local AutoOn=false
local function firePrompt(p) if not p then return end pcall(function() p.HoldDuration=0 p.Enabled=true fireproximityprompt(p) end) end
local function cycle()
    while AutoOn do
        local h=hrp() if not h then task.wait(0.5) continue end
        local e=farthestEgg()
        if not e then notify("No egg found!") task.wait(2) continue end
        local p=eggPos(e) if not p then task.wait(0.5) continue end
        flyTo(p,20) task.wait(0.2) if not AutoOn then break end
        local pr=findCarryPrompt(e) if pr then firePrompt(pr) task.wait(0.5) end
        if not AutoOn then break end
        local bp=playerBase()
        if bp then
            flyTo(bp,25) task.wait(0.3) if not AutoOn then break end
            local dp=dropPrompt() if dp then firePrompt(dp) task.wait(0.4) end
        end
        task.wait(0.3)
    end
end
local function startAuto() if AutoOn then return end AutoOn=true task.spawn(cycle) end
local function stopAuto() AutoOn=false stopFly() end

-- Anti-hit
local function isMover(i)
    return i:IsA("BodyVelocity") or i:IsA("BodyAngularVelocity") or i:IsA("BodyThrust")
        or i:IsA("BodyForce") or i:IsA("BodyGyro") or i:IsA("VectorForce")
        or i:IsA("LinearVelocity") or i:IsA("AngularVelocity") or i:IsA("Torque")
end
local function restore()
    local c=LP.Character if not c then return end
    local hum=c:FindFirstChildOfClass("Humanoid") if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,true)
        hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding,true)
    end)
end
local function hookChar(c)
    c.DescendantAdded:Connect(function(d)
        if d.Name=="XdrgAutoFly" then return end
        if (Flags.NoKB or Flags.AntiFling) and isMover(d) then task.defer(function() if d and d.Parent then d:Destroy() end end) end
    end)
end
if LP.Character then hookChar(LP.Character) end
LP.CharacterAdded:Connect(hookChar)

RunService.Heartbeat:Connect(function()
    if Flags.NoKB or Flags.AntiRag or Flags.AntiFling then
        local c=LP.Character
        if c then
            local hum=c:FindFirstChildOfClass("Humanoid")
            local h=c:FindFirstChild("HumanoidRootPart")
            if (Flags.NoKB or Flags.AntiRag) and hum then
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding,false)
                    local s=hum:GetState()
                    if s==Enum.HumanoidStateType.FallingDown or s==Enum.HumanoidStateType.Ragdoll or s==Enum.HumanoidStateType.PlatformStanding then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end)
            end
            if (Flags.NoKB or Flags.AntiFling) and h then
                for _,v in ipairs(h:GetChildren()) do
                    if isMover(v) and v.Name~="XdrgAutoFly" then v:Destroy() end
                end
            end
        end
    end
    if Flags.AntiGuard then
        local h=hrp()
        if h then
            for _,o in ipairs(workspace:GetDescendants()) do
                if o:IsA("BasePart") then
                    local n=o.Name:lower()
                    if (n:find("guard") or n:find("hitbox") or n:find("damage")) and (o.Position-h.Position).Magnitude<30 then
                        pcall(function() o.CanCollide=false o.CanTouch=false o.CanQuery=false end)
                    end
                end
            end
        end
    end
end)

