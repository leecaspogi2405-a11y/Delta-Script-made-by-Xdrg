local CurrentTheme = Themes["Blue/Black"]
local ThemeTargets = {}
local ToggleRegistry = {}

local function link(obj, prop, role)
    ThemeTargets[#ThemeTargets + 1] = { obj = obj, prop = prop, role = role }
    return obj
end

local function ApplyTheme(name)
    local t = Themes[name]
    if not t then return end
    CurrentTheme = t
    for _, e in ipairs(ThemeTargets) do
        pcall(function() e.obj[e.prop] = t[e.role] end)
    end
    for _, tog in ipairs(ToggleRegistry) do
        tog.pill.BackgroundColor3 = tog.isOn() and t.accent or t.toggleOff
    end
end

--==================== HELPERS ====================--
local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = obj
    return c
end

local function makeDraggable(frame, onClick)
    local dragging, moved = false, false
    local dragStart, startPos

    local function inside(pos)
        local ap, as = frame.AbsolutePosition, frame.AbsoluteSize
        return pos.X >= ap.X and pos.X <= ap.X + as.X
           and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
    end

    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if inside(input.Position) then
                dragging = true
                moved = false
                dragStart = input.Position
                startPos = frame.Position
            end
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
                moved = true
            end
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not moved and onClick then
                onClick()
            end
            dragging = false
        end
    end)
end

