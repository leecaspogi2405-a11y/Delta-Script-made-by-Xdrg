local function makeDraggable(frame, onClick)
    local dragging,moved,dragStart,startPos=false,false
    local function inside(pos)
        local ap,as=frame.AbsolutePosition,frame.AbsoluteSize
        return pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y
    end
    UIS.InputBegan:Connect(function(input,gpe)
        if gpe then return end
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            if inside(input.Position) then dragging=true moved=false dragStart=input.Position startPos=frame.Position end
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
            local d=input.Position-dragStart
            if math.abs(d.X)>4 or math.abs(d.Y)>4 then moved=true end
            frame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            if dragging and not moved and onClick then onClick() end
            dragging=false
        end
    end)
end

