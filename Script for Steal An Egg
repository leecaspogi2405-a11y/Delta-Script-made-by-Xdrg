    corner(knob, 9)

    local state = false
    local function setState(v, silent)
        state = v
        local t = CurrentTheme
        TweenService:Create(pill, TweenInfo.new(0.18), {
            BackgroundColor3 = v and t.accent or t.toggleOff
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = v and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        }):Play()
        callback(v, silent)
    end

    row.MouseButton1Click:Connect(function()
        setState(not state)
    end)

    ToggleRegistry[#ToggleRegistry + 1] = {
        pill = pill,
        isOn = function() return state end
    }
    return { setState = setState, getState = function() return state end }
end

