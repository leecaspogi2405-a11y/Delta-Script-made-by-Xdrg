--==================== ANTI-HIT CORE ====================--
local function isMover(inst)
    return inst:IsA("BodyVelocity") or inst:IsA("BodyAngularVelocity")
        or inst:IsA("BodyThrust") or inst:IsA("BodyForce") or inst:IsA("BodyGyro")
        or inst:IsA("VectorForce") or inst:IsA("LinearVelocity") or inst:IsA("AngularVelocity")
        or inst:IsA("Torque") or inst:IsA("AlignPosition") or inst:IsA("AlignOrientation")
end

local function restoreStates()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)
    end)
end

local function hookCharacter(char)
    char.DescendantAdded:Connect(function(d)
        if (Flags.NoKnockback or Flags.AntiFling) and isMover(d) then
            task.defer(function() if d and d.Parent then d:Destroy() end end)
        end
    end)
end

if LP.Character then hookCharacter(LP.Character) end
LP.CharacterAdded:Connect(hookCharacter)

--==================== FLY SYSTEM ====================--
local Fly = { active = false, speed = 430, bodyVel = nil, bodyGyro = nil, connection = nil }

local function stopFly()
    if Fly.bodyVel then Fly.bodyVel:Destroy() Fly.bodyVel = nil end
    if Fly.bodyGyro then Fly.bodyGyro:Destroy() Fly.bodyGyro = nil end
    if Fly.connection then Fly.connection:Disconnect() Fly.connection = nil end
    Fly.active = false
end

local function startFly()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    stopFly()
    Fly.active = true

    local bv = Instance.new("BodyVelocity")
    bv.Name = "XdrgFlyVel"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.Name = "XdrgFlyGyro"
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 3000
    bg.D = 50
    bg.Parent = hrp

    Fly.bodyVel = bv
    Fly.bodyGyro = bg

    Fly.connection = RunService.RenderStepped:Connect(function()
        if not Fly.active or not hrp.Parent then stopFly() return end
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        bv.Velocity = (dir.Magnitude > 0) and (dir.Unit * Fly.speed) or Vector3.zero
        bg.CFrame = cam.CFrame
    end)
end

--==================== EGG LOGIC ====================--
local function getEggPosition(egg)
    if egg:IsA("Model") and egg.PrimaryPart then return egg.PrimaryPart.Position
    elseif egg:IsA("BasePart") then return egg.Position end
    return nil
end

local function getProximityPrompt(egg)
    for _, d in ipairs(egg:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then return d end
    end
    for _, d in ipairs(egg:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
    return nil
end

local function findEggFolder()
    local eggsFolder = workspace:FindFirstChild("Eggs")
    if eggsFolder then return eggsFolder end
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Folder") and v.Name:lower():find("egg") then return v end
    end
    return nil
end

local function findPriorityEgg()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local eggsFolder = findEggFolder()
    if not eggsFolder then return nil end
    local bestEgg, bestEggDist = nil, -1
    for _, egg in ipairs(eggsFolder:GetChildren()) do
        local pos = getEggPosition(egg)
        if pos then
            local dist = (pos - hrp.Position).Magnitude
            local selected = false
            for selName, _ in pairs(SelectedEggs) do
                if egg.Name == selName or egg.Name:find(selName) or selName:find(egg.Name) then
                    selected = true
                    break
                end
            end
            if next(SelectedEggs) == nil then selected = true end
            if selected and dist > bestEggDist then
                bestEggDist = dist
                bestEgg = egg
            end
        end
    end
    return bestEgg, bestEggDist
end

local function tryStealEgg(egg)
    if not egg then return false end
    local char = LP.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos = getEggPosition(egg)
    if not pos then return false end
    local prompt = getProximityPrompt(egg)
    if prompt then
        local dist = (pos - hrp.Position).Magnitude
        if dist > prompt.MaxActivationDistance then
            hrp.CFrame = CFrame.new(pos)
            task.wait(0.1)
        end
        pcall(function() fireproximityprompt(prompt) end)
        return true
    end
    for _, d in ipairs(egg:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            pcall(function() d:FireServer() end)
        end
    end
    return false
end

local function autoStealLoop()
    if not (Flags.AutoSteal or Flags.FlySteal) then return end
    local egg = findPriorityEgg()
    if egg then tryStealEgg(egg) end
end

local function antiGuardLoop()
    if not Flags.AntiGuard then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if (n:find("guard") or n:find("hitbox") or n:find("damage")) then
                local dist = (obj.Position - hrp.Position).Magnitude
                if dist < 30 then
                    pcall(function()
                        obj.CanCollide = false
                        obj.CanTouch = false
                        obj.CanQuery = false
                    end)
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if Flags.NoKnockback or Flags.AntiRagdoll or Flags.AntiFling then
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if (Flags.NoKnockback or Flags.AntiRagdoll) and hum then
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                    local st = hum:GetState()
                    if st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.PlatformStanding then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end)
            end
            if (Flags.NoKnockback or Flags.AntiFling) and hrp then
                for _, v in ipairs(hrp:GetChildren()) do
                    if isMover(v) then v:Destroy() end
                end
            end
        end
    end
    if Flags.AutoSteal or Flags.FlySteal then autoStealLoop() end
    if Flags.AntiGuard then antiGuardLoop() end
end)

