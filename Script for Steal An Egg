    local s = Instance.new("UIStroke")
    s.Color = CurrentTheme.accent
    s.Transparency = 1
    s.Parent = n

    TweenService:Create(n, TweenInfo.new(0.2), { BackgroundTransparency = 0.1, TextTransparency = 0 }):Play()
    TweenService:Create(s, TweenInfo.new(0.2), { Transparency = 0.4 }):Play()

    task.delay(2, function()
        TweenService:Create(n, TweenInfo.new(0.3), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
        TweenService:Create(s, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        task.wait(0.35)
        n:Destroy()
    end)
end

