local contentHeight = 0
local viewHeight = 0

local function updateScroll()
    viewHeight = content.AbsoluteSize.Y
    local maxScroll = math.max(0, contentHeight - viewHeight)
    if scrollY.Position.Y.Offset < -maxScroll then
        scrollY.Position = UDim2.new(0,0,0,-maxScroll)
    end
end

scrollUp.MouseButton1Click:Connect(function()
    local newY = scrollY.Position.Y.Offset + 60
    if newY > 0 then newY = 0 end
    scrollY.Position = UDim2.new(0,0,0,newY)
end)

scrollDown.MouseButton1Click:Connect(function()
    local maxScroll = math.max(0, contentHeight - viewHeight)
    local newY = scrollY.Position.Y.Offset - 60
    if newY < -maxScroll then newY = -maxScroll end
    scrollY.Position = UDim2.new(0,0,0,newY)
end)

-- Each tab creates its own container Frame inside scrollY
local tabPages = {}
local tabButtons = {}
local activeTab = nil

local function switchTab(name)
    if activeTab and tabPages[activeTab] then
        tabPages[activeTab].visible = false
        tabPages[activeTab].frame.Visible = false
        tabButtons[activeTab].BackgroundColor3=C.header
        tabButtons[activeTab].TextColor3=C.sub
    end
    activeTab=name
    tabPages[name].visible = true
    tabPages[name].frame.Visible = true
    tabButtons[name].BackgroundColor3=C.accent
    tabButtons[name].TextColor3=C.white
    
    -- Reset scroll
    scrollY.Position = UDim2.new(0,0,0,0)
    contentHeight = tabPages[name].height
    updateScroll()
end

