--==================== CORE: EGG FINDER ====================--
local function getHRP()
    local char=LP.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getEggPosition(egg)
    if egg:IsA("Model") then
        if egg.PrimaryPart then return egg.PrimaryPart.Position end
        local p=egg:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
    elseif egg:IsA("BasePart") then
        return egg.Position
    end
    return nil
end

-- Hanapin ang "CarryAreaEgg" prompt (KEY!)
local function findCarryPrompt(egg)
    -- Priority: sa loob mismo ng egg
    for _,d in ipairs(egg:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Name=="CarryAreaEgg" then return d end
    end
    -- Any ProximityPrompt sa egg
    for _,d in ipairs(egg:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
    -- Sa parent folder
    if egg.Parent then
        for _,d in ipairs(egg.Parent:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Name=="CarryAreaEgg" then return d end
        end
    end
    return nil
end

-- Hanapin lahat ng egg objects
local function getAllEggs()
    local list={}
    local folder=workspace:FindFirstChild("Eggs")
    if folder then
        for _,v in ipairs(folder:GetChildren()) do list[#list+1]=v end
        if #list>0 then return list end
    end
    -- Fallback scan
    for _,v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("BasePart")) and v.Name:lower():find("egg") then
            list[#list+1]=v
        end
    end
    return list
end

local function isEggSelected(eggName)
    if next(SelectedEggs)==nil then return true end
    for sel,_ in pairs(SelectedEggs) do
        if eggName==sel or eggName:find(sel,1,true) or sel:find(eggName,1,true) then return true end
    end
    return false
end

local function findFarthestSelectedEgg()
    local hrp=getHRP() if not hrp then return nil end
    local eggs=getAllEggs()
    local best,bestDist=nil,-1
    for _,egg in ipairs(eggs) do
        if isEggSelected(egg.Name) then
            local pos=getEggPosition(egg)
            if pos then
                local d=(pos-hrp.Position).Magnitude
                if d>bestDist then bestDist=d best=egg end
            end
        end
    end
    return best,bestDist
end

--==================== CORE: BASE FINDER ====================--
-- Priority: 1) Manual set, 2) Auto-detect player plot, 3) SpawnLocation
local function findPlayerBase()
    if CustomBasePos then return CustomBasePos end
    
    -- Subukan hanapin ang plot ng player
    local plotNames={"Plot","Plots","Base","Bases","Pen","Pens","Farm","Farms","Island","Islands"}
    for _,pn in ipairs(plotNames) do
        local folder=workspace:FindFirstChild(pn)
        if folder then
            -- Hanapin ang subfolder/part na may pangalan ng player
            for _,child in ipairs(folder:GetChildren()) do
                if child.Name:lower():find(LP.Name:lower(),1,true) or child.Name:lower():find(LP.DisplayName:lower(),1,true) then
                    if child:IsA("BasePart") then return child.Position end
                    if child:IsA("Model") and child.PrimaryPart then return child.PrimaryPart.Position end
                    -- Hanapin ang "Center" part sa loob
                    for _,sub in ipairs(child:GetDescendants()) do
                        if sub:IsA("BasePart") and (sub.Name:lower():find("center") or sub.Name:lower():find("spawn") or sub.Name:lower():find("base")) then
                            return sub.Position
                        end
                    end
                end
            end
        end
    end
    
    -- Fallback: SpawnLocation
    for _,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("SpawnLocation") then return v.Position end
    end
    
    return nil
end

-- Hanapin ang drop/hatch prompt sa base
local function findDropPrompt()
    local dropNames={"DropEgg","PlaceEgg","HatchEgg","StoreEgg","DepositEgg","EggDrop","EggPlace"}
    for _,d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            for _,n in ipairs(dropNames) do
                if d.Name==n then return d end
            end
            if d.Name:lower():find("drop") or d.Name:lower():find("place") or d.Name:lower():find("hatch") then
                return d
            end
        end
    end
    return nil
end

