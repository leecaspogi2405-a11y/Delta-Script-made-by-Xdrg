local function activateTab(name)
    if ActiveTab then
        Tabs[ActiveTab].btn.BackgroundColor3 = CurrentTheme.header
        Tabs[ActiveTab].btn.TextColor3 = CurrentTheme.subtext
        Tabs[ActiveTab].page.Visible = false
    end
    ActiveTab = name
    Tabs[name].btn.BackgroundColor3 = CurrentTheme.accent
    Tabs[name].btn.TextColor3 = CurrentTheme.bg
    Tabs[name].page.Visible = true
end

