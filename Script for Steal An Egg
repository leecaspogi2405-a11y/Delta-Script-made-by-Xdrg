for _,bi in ipairs(BiomeData) do
    addSection(eP,bi.name)
    for _,en in ipairs(bi.eggs) do
        local full=en.." Egg"
        local b=Instance.new("TextButton")
        b.Size=UDim2.new(1,0,0,28) b.BackgroundColor3=C.panel b.Text="  "..en
        b.Font=Enum.Font.GothamMedium b.TextSize=11 b.TextColor3=C.text
        b.TextXAlignment=Enum.TextXAlignment.Left
        b.AutoButtonColor=false b.BorderSizePixel=0 b.LayoutOrder=no() b.Parent=eP
        corner(b,6)
        eggBtns[full]={btn=b,sel=false}
        b.MouseButton1Click:Connect(function()
            local d=eggBtns[full]
            d.sel=not d.sel
            if d.sel then Selected[full]=true else Selected[full]=nil end
            refreshAll() notify(en.." "..(d.sel and "ON" or "OFF"))
        end)
    end
end

