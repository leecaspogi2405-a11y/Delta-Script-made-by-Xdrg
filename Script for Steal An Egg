local Fly={bv=nil,active=false,speed=430}

local function stopFly()
    if Fly.bv then Fly.bv:Destroy() Fly.bv=nil end
    Fly.active=false
end

local function flyToPosition(targetPos, timeout)
    local hrp=getHRP() if not hrp then return false end
    timeout=timeout or 15
    
    stopFly()
    Fly.active=true
    
    local bv=Instance.new("BodyVelocity")
    bv.Name="XdrgAutoFly"
    bv.MaxForce=Vector3.new(1e5,1e5,1e5)
    bv.Velocity=Vector3.zero
    bv.Parent=hrp
    Fly.bv=bv
    
    local startTime=tick()
    
    while Fly.active and hrp.Parent and (tick()-startTime)<timeout do
        local curPos=hrp.Position
        local delta=targetPos-curPos
        local dist=delta.Magnitude
        
        if dist<8 then
            bv.Velocity=Vector3.zero
            break
        end
        
        -- Speed adjustment: bumabagal pag malapit na
        local speed=Fly.speed
        if dist<30 then speed=math.max(50,dist*15) end
        
        bv.Velocity=delta.Unit*speed
        RunService.Heartbeat:Wait()
    end
    
    if bv then bv:Destroy() end
    if Fly.bv==bv then Fly.bv=nil end
    Fly.active=false
    return true
end

--==================== CORE: FULL AUTO STEAL CYCLE ====================--
local AutoStealing=false

local function firePrompt(prompt)
    if not prompt then return false end
    pcall(function()
        prompt.HoldDuration=0
        prompt.Enabled=true
        fireproximityprompt(prompt)
    end)
    return true
end

local function fullAutoStealCycle()
    while AutoStealing do
        local hrp=getHRP()
        if not hrp then task.wait(0.5) continue end
        
        -- STEP 1: Hanapin ang pinakamalayong selected egg
        local egg,dist=findFarthestSelectedEgg()
        if not egg then
            notify("⚠️ Walang egg na nahanap. Pumili sa Egg Select tab.")
            task.wait(2)
            continue
        end
        
        local eggPos=getEggPosition(egg)
        if not eggPos then task.wait(0.5) continue end
        
        -- STEP 2: Lumipad papunta sa egg
        flyToPosition(eggPos, 20)
        task.wait(0.2)
        
        if not AutoStealing then break end
        
        -- STEP 3: Kunin ang egg (fire CarryAreaEgg prompt)
        local prompt=findCarryPrompt(egg)
        if prompt then
            firePrompt(prompt)
            task.wait(0.5)
        end
        
        if not AutoStealing then break end
        
        -- STEP 4: Hanapin ang base at lumipad pabalik
        local basePos=findPlayerBase()
        if basePos then
            flyToPosition(basePos, 25)
            task.wait(0.3)
            
            if not AutoStealing then break end
            
            -- STEP 5: I-drop ang egg sa base
            local dropPrompt=findDropPrompt()
            if dropPrompt then
                firePrompt(dropPrompt)
                task.wait(0.4)
            end
        end
        
        task.wait(0.3)
    end
end

local function startAutoSteal()
    if AutoStealing then return end
    AutoStealing=true
    task.spawn(fullAutoStealCycle)
end

local function stopAutoSteal()
    AutoStealing=false
    stopFly()
end

--==================== ANTI-HIT ====================--
local function isMover(i)
    return i:IsA("BodyVelocity") or i:IsA("BodyAngularVelocity") or i:IsA("BodyThrust")
        or i:IsA("BodyForce") or i:IsA("BodyGyro") or i:IsA("VectorForce")
        or i:IsA("LinearVelocity") or i:IsA("AngularVelocity") or i:IsA("Torque")
        or i:IsA("AlignPosition") or i:IsA("AlignOrientation")
end

local function restoreStates()
    local char=LP.Character if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid") if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,true)
        hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding,true)
    end)
end

local function hookCharacter(char)
    char.DescendantAdded:Connect(function(d)
        if d.Name=="XdrgAutoFly" then return end
        if (Flags.NoKnockback or Flags.AntiFling) and isMover(d) then
            task.defer(function() if d and d.Parent then d:Destroy() end end)
        end
    end)
end

if LP.Character then hookCharacter(LP.Character) end
LP.CharacterAdded:Connect(hookCharacter)

local function antiGuardLoop()
    if not Flags.AntiGuard then return end
    local hrp=getHRP() if not hrp then return end
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n=obj.Name:lower()
            if n:find("guard") or n:find("hitbox") or n:find("damage") then
                if (obj.Position-hrp.Position).Magnitude<30 then
                    pcall(function()
                        obj.CanCollide=false obj.CanTouch=false obj.CanQuery=false
                    end)
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if Flags.NoKnockback or Flags.AntiRagdoll or Flags.AntiFling then
        local char=LP.Character
        if char then
            local hum=char:FindFirstChildOfClass("Humanoid")
            local hrp=char:FindFirstChild("HumanoidRootPart")
            if (Flags.NoKnockback or Flags.AntiRagdoll) and hum then
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding,false)
                    local st=hum:GetState()
                    if st==Enum.HumanoidStateType.FallingDown or st==Enum.HumanoidStateType.Ragdoll or st==Enum.HumanoidStateType.PlatformStanding then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end)
            end
            if (Flags.NoKnockback or Flags.AntiFling) and hrp then
                for _,v in ipairs(hrp:GetChildren()) do
                    if isMover(v) and v.Name~="XdrgAutoFly" then v:Destroy() end
                end
            end
        end
    end
    if Flags.AntiGuard then antiGuardLoop() end
end)

