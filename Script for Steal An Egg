-- Resize
local rh = Instance.new("TextButton")
rh.Size=UDim2.fromOffset(16,16) rh.Position=UDim2.new(1,-20,1,-20)
rh.BackgroundColor3=C.accent rh.Text="*" rh.Font=Enum.Font.GothamBold
rh.TextSize=12 rh.TextColor3=C.white rh.AutoButtonColor=false
rh.BorderSizePixel=0 rh.ZIndex=5 rh.Parent=main
corner(rh,4)

local rs,rs0,rsz = false,nil,nil
rh.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        rs=true rs0=i.Position rsz=main.AbsoluteSize
    end
end)
UIS.InputChanged:Connect(function(i)
    if not rs then return end
    if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
        local d=i.Position-rs0
        main.Size=UDim2.fromOffset(math.max(280,rsz.X+d.X),math.max(340,rsz.Y+d.Y))
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then rs=false end
end)

switchTab("Main")
notify("Xdrg v11.0 loaded")
