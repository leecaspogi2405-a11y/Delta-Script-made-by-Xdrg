local function getBase()
    local num = LocalPlayer:GetAttribute("baseNumber")
    return workspace.Map.PlayerBases[num].PlayArea
end

local function getCharacter()
    local char = LocalPlayer.Character
    if not char then
        char = LocalPlayer.CharacterAdded:Wait()
    end
    return char:WaitForChild("HumanoidRootPart"), char:WaitForChild("Humanoid")
end

local function getBasePosition()
    local area = getBase()
    local base = area:FindFirstChild("Base")
    if base then
        if base:IsA("BasePart") then
            return base.Position
        end
        local part = base:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.Position
        end
    end
    return area.TowerBase.KickZoneText.Position
end

local SUFFIX = {
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
}

local function parseEarnings(text)
    if not text then return 0 end
    local num, suffix = string.match(text, "%$([%d%.]+)([KMBT])/s")
    if not num then return 0 end
    return (tonumber(num) or 0) * (SUFFIX[suffix] or 1)
end

local RARITY_RANK = {
    Common = 1,
    Uncommon = 2,
    Rare = 3,
    Epic = 4,
    Legendary = 5,
    Mythical = 6,
    Cosmic = 7,
    Secret = 8,
    Celestial = 9,
    Divine = 10,
}

local function scoreModel(model)
    local tag = model:FindFirstChild("BillboardGuiNameTag", true)
    if not tag then return nil end
    local rarityLabel = tag:FindFirstChild("TextLabelRarity")
    local earnLabel = tag:FindFirstChild("TextLabelEarning")
    local levelLabel = tag:FindFirstChild("TextLabelLevel")
    local rank = (rarityLabel and RARITY_RANK[rarityLabel.Text]) or 0
    local earn = parseEarnings(earnLabel and earnLabel.Text)
    local level = tonumber(levelLabel and string.match(levelLabel.Text, "Lv%.(%d+)")) or 0
    return rank * 1e18 + earn * 1e3 + level
end

local function selfHeal()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.WalkSpeed == 0 and LocalPlayer:GetAttribute("isInKickSession") ~= true then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end
end

