function Kick()
    if _G.KickRunning then return end
    task.spawn(function()
        _G.KickRunning = true
        local failedClaims = 0
        local submitTime = 0
        local startAttempts = 0
        local returnCooldown = 0
        while _G.Kick do
            task.wait()
            xpcall(function()
                if os.clock() < returnCooldown then return end
                local inSession = LocalPlayer:GetAttribute("isInKickSession") == true
                local inThrowZone = LocalPlayer:GetAttribute("isInThrowZone") == true
                if inSession and not ballLanded then
                    if submitTime == 0 then submitTime = os.clock() end
                    if os.clock() - submitTime > 30 then
                        RF.ReturnFromKick:InvokeServer()
                        submitTime, failedClaims, ballLanded = 0, 0, false
                        returnCooldown = os.clock() + 2
                    end
                elseif inSession and ballLanded then
                    local rewards = {}
                    for _, model in ipairs(workspace.Brainrots:GetDescendants()) do
                        if model:IsA("Model") and model:GetAttribute("kickRewardId") then
                            local score = scoreModel(model)
                            if score then
                                table.insert(rewards, { model = model, score = score })
                            end
                        end
                    end
                    if #rewards > 0 then
                        table.sort(rewards, function(a, b) return a.score > b.score end)
                        local entry = rewards[1]
                        getCharacter().CFrame = entry.model:GetPivot()
                        task.wait(0.2)
                        local ok = RF.ClaimKickReward:InvokeServer(entry.model:GetAttribute("kickRewardId"))
                        if ok then
                            failedClaims = 0
                        else
                            failedClaims += 1
                        end
                        task.wait(0.3)
                    else
                        failedClaims += 1
                    end
                    if failedClaims >= 4 then
                        RF.ReturnFromKick:InvokeServer()
                        submitTime, failedClaims, ballLanded = 0, 0, false
                        startAttempts = 0
                        returnCooldown = os.clock() + 2
                    end
                elseif not inThrowZone then
                    startAttempts = 0
                    selfHeal()
                    local root = getCharacter()
                    root.CFrame = CFrame.new(getBasePosition() + Vector3.new(0, 5, 0))
                    task.wait(0.6)
                    root.CFrame = CFrame.new(getBase().TowerBase.KickZoneText.Position)
                    local t0 = os.clock()
                    while _G.Kick and os.clock() - t0 < 3 do
                        if LocalPlayer:GetAttribute("isInThrowZone") == true then break end
                        task.wait(0.1)
                    end
                else
                    selfHeal()
                    Signals.Fire("CancelKickMinigame")
                    task.wait(0.3)
                    ballLanded = false
                    Signals.Fire("StartKickMinigame")
                    task.wait(0.5)
                    Signals.Fire("ConfirmKickAlpha", 1)
                    submitTime = os.clock()
                    startAttempts += 1
                    local t0 = os.clock()
                    while _G.Kick and os.clock() - t0 < 5 do
                        if LocalPlayer:GetAttribute("isInKickSession") == true then
                            startAttempts = 0
                            break
                        end
                        task.wait(0.2)
                    end
                    if startAttempts > 1 then
                        task.wait(math.min(startAttempts, 3))
                    end
                end
            end, function(err)
                warn("[Kick] " .. tostring(err))
            end)
        end
        _G.KickRunning = false
    end)
end

function Train()
    task.spawn(function()
        _G.Train = true
        while _G.Train do
            task.wait()
            pcall(function()
                LocalPlayer:WaitForChild("Backpack")
                local backpack = LocalPlayer.Backpack
                local _, humanoid = getCharacter()
                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") and tool:GetAttribute("weightKey") ~= nil then
                        humanoid:EquipTool(tool)
                    end
                end
                for _ = 1, 6 do
                    RF.ClaimX2PowerCircle:InvokeServer(1)
                end
                task.wait(1.5)
            end)
        end
    end)
end

function Cash()
    task.spawn(function()
        _G.Cash = true
        while _G.Cash do
            task.wait()
            pcall(function()
                local slots = getBase().Base.BrainrotSlots
                for _, slot in ipairs(slots:GetChildren()) do
                    if slot:GetAttribute("hasBrainrot") == true then
                        RF.ClaimEarnings:InvokeServer(slot.Name)
                        task.wait(0.2)
                    end
                end
                task.wait(2)
            end)
        end
    end)
end

