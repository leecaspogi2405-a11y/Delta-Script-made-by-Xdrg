local function generateWithXdrgAI(prompt)
    LoadingFrame.Visible = true
    
    local success, result = pcall(function()
        local response = HttpService:PostAsync(
            XDRAGON_AI_ENDPOINT,
            HttpService:JSONEncode({
                inputs = "<s>[INST] You are Xdrg AI, a Roblox Lua scripting expert from Xdragon Hub. Generate a complete, working Roblox Lua script for: " .. prompt .. ". Return ONLY the Lua code without explanations. [/INST]"
            }),
            Enum.HttpContentType.ApplicationJson,
            false,
            {
                ["Authorization"] = "Bearer " .. XDRAGON_AI_KEY
            }
        )
        return response
    end)
    
    LoadingFrame.Visible = false
    
    if success and result then
        local data = HttpService:JSONDecode(result)
        if data and data[1] and data[1].generated_text then
            local generated = data[1].generated_text
            -- Extract code if wrapped in markdown
            local codeMatch = generated:match("```lua\n(.-)```") or generated:match("```\n(.-)```")
            return codeMatch or generated
        end
    end
    
    -- Fallback to local generation
    return generateLocalScript(prompt)
end

