-- ==================== AI FUNCTION - ALWAYS GENERATES SCRIPT ====================
local function askXdrgAI(prompt)
    LoadingFrame.Visible = true
    
    local systemPrompt = [[You are Xdrg AI from Xdragon Hub, an expert Roblox Lua scripter. You understand BOTH English and Tagalog/Filipino. You MUST ALWAYS generate a complete, working Roblox Lua script based on the user's request. NEVER say you cannot do it. ALWAYS return Lua code.

You understand natural language. Examples:
- "gusto ko mabilis tumakbo" = speed boost script
- "gawan mo ako ng teleport" = teleport script  
- "kailangan ko ng sword fighting" = combat script
- "make me fly" = fly script
- "bigyan mo ako ng shop system" = shop script
- "I want to be invisible" = invisibility script
- "gumawa ka ng leaderboard" = leaderboard script
- "auto farm po" = auto farming script
- "gawan mo ako ng walang kwentang bagay" = simple script

ALWAYS return a working Roblox Lua script. Use game:GetService() correctly. Always include proper Roblox API usage.]]
    
    local success, result = pcall(function()
        local response = HttpService:PostAsync(
            XDRAGON_AI_ENDPOINT,
            HttpService:JSONEncode({
                inputs = "<s>[INST] " .. systemPrompt .. "\n\nUser request: " .. prompt .. "\n\nGenerate the Roblox Lua script now: [/INST]"
            }),
            Enum.HttpContentType.ApplicationJson,
            false,
            {
                ["Authorization"] = "Bearer " .. XDRAGON_AI_KEY
            }
        )
        return response
    end)
    
    LoadingFrame.Visible = false
    
    if success and result then
        pcall(function()
            local data = HttpService:JSONDecode(result)
            if data and data[1] and data[1].generated_text then
                local generated = data[1].generated_text
                -- Extract the Lua code
                local code = generated:match("```lua\n(.-)```") or 
                             generated:match("```\n(.-)```") or
                             generated:match("local.-") or
                             generated
                return code
            end
        end)
    end
    
    -- ALWAYS return something - never nil
    return [[-- Generated by Xdragon Hub AI
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

print("Xdragon Hub AI Script loaded!")

-- Request: ]] .. prompt .. [[

Players.PlayerAdded:Connect(function(player)
    print(player.Name .. " joined the game!")
    
    player.CharacterAdded:Connect(function(character)
        print(player.Name .. " spawned!")
        -- Add your custom logic here based on: ]] .. prompt .. [[
    end)
end)]]
end

