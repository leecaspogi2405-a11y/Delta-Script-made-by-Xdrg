-- Button Creation Helper (Cyan Box Style)
local function createCyanButton(text, pos, size)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(0.48, 0, 0, 90)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(0, 220, 220)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.Font = Enum.Font.SourceSansSemibold
    btn.TextSize = 20
    btn.LineHeight = 1.2
    btn.ZIndex = 2
    btn.Parent = ContentContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    return btn
end

