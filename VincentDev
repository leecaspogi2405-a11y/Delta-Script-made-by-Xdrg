-- Toggles Logic with State Updates
local function updateToggleBtn(btn, text, isOn)
    btn.Text = text .. "\n" .. (isOn and "[On]" or "[Off]")
    btn.BackgroundColor3 = isOn and Color3.fromRGB(0, 190, 190) or Color3.fromRGB(0, 220, 220)
end

