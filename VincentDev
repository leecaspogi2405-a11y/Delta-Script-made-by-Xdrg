                -- The REAL method to buy items uses FireServer
                -- It targets standard shop remotes instead of the fake GUI visual remote.
                local RS = game:GetService("ReplicatedStorage")
                local remoteFolder = RS:FindFirstChild("RemoteEvents") or RS:FindFirstChild("Remotes")
                
                if remoteFolder then
                    -- Scans the folder for anything related to Buying or Purchasing
                    for _, remote in pairs(remoteFolder:GetChildren()) do
                        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                            local lowerName = remote.Name:lower()
