RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    if flyOn and flyBodyVel and flyBodyGyro and hum then
        local cam = workspace.CurrentCamera
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            local flightVector = (cam.CFrame.LookVector * moveDir.Z) + (cam.CFrame.RightVector * moveDir.X)
            flyBodyVel.Velocity = flightVector * flySpeed
        else
            flyBodyVel.Velocity = Vector3.zero
        end
        flyBodyGyro.CFrame = cam.CFrame
    end
    
    if hum and hum.WalkSpeed ~= speedValue then hum.WalkSpeed = speedValue end

    if invincibleOn then
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                if obj.Transparency < 1 then obj.Transparency = 1 end
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                if obj.Enabled then obj.Enabled = false end
            end
        end
        if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
    end

    if antiDamageOn and hum then
        if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        if not char:FindFirstChildOfClass("ForceField") then
            local ff = Instance.new("ForceField", char)
            ff.Visible = false
        end
    end
end)

