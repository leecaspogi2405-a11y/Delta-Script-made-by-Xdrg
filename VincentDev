--[[
    Remote Event Call
    Ang args[1] ay isang `buffer`. Hindi natin alam ang packet format ng laro.
    Nagbigay ako ng dummy buffer dito. USER DAPAT I-REPLACE ITO NG TAMA.
]]
local function callStealRemote()
    -- !!! USER: PALITAN ANG BUFFER CONTENT SA IBABA NG TAMA !!!
    -- Halimbawa ng paggawa ng simpleng buffer na may size 1
    local dummyBuffer = buffer.create(1) 
    buffer.writeu8(dummyBuffer, 0, 1) -- Naglagay ng 1 byte na 1

    local args = {
        [1] = dummyBuffer
    }
    
    local remote = ReplicatedStorage:FindFirstChild("SharedModules")
        and ReplicatedStorage.SharedModules:FindFirstChild("Packet")
        and ReplicatedStorage.SharedModules.Packet:FindFirstChild("RemoteEvent")
        
    if remote then
        remote:FireServer(unpack(args))
    else
        warn("Cannot find RemoteEvent at SharedModules.Packet.RemoteEvent")
    end
end


