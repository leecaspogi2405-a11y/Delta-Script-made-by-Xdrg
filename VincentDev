-- ================= MAIN LOOPS =================
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    if flyOn and flyBodyVel and flyBodyGyro and hum then
        local cam = workspace.CurrentCamera
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            local flightVector = (cam.CFrame.LookVector * moveDir.Z) + (cam.CFrame.RightVector * moveDir.X)
            flyBodyVel.Velocity = flightVector * flySpeed
        else
            flyBodyVel.Velocity = Vector3.zero
        end
        flyBodyGyro.CFrame = cam.CFrame
    end
    
    -- Update walk speed
    if hum and hum.WalkSpeed ~= speedValue then
        hum.WalkSpeed = speedValue
    end
end)

-- Character added handler for invisibility and speed
LocalPlayer.CharacterAdded:Connect(function(char)
    if invincibleOn then
        -- Reapply invisibility on new character
        task.wait(0.1)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end
    end
    
    if speedValue ~= 16 then
        task.wait(0.5)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = speedValue
        end
    end
end)

