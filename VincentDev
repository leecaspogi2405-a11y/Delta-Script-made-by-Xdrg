local flySpeed = 50
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    if flyOn and flyBodyVel and flyBodyGyro and hum then
        local cam = workspace.CurrentCamera
        local moveDir = hum.MoveDirection

        if moveDir.Magnitude > 0 then
            local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
            local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z).Unit
            
            local forwardInput = moveDir:Dot(flatLook)
            local rightInput = moveDir:Dot(flatRight)
            
            local flightVector = (cam.CFrame.LookVector * forwardInput) + (cam.CFrame.RightVector * rightInput)
            flyBodyVel.Velocity = flightVector * flySpeed
        else
            flyBodyVel.Velocity = Vector3.zero
        end
        flyBodyGyro.CFrame = cam.CFrame
    end

    if antiDamageOn then
        if not shieldPart or not shieldPart.Parent then
            shieldPart = Instance.new("Part")
            shieldPart.Name = "AntiDamagePart"
            shieldPart.Shape = Enum.PartType.Cylinder
            shieldPart.Size = Vector3.new(12, 10, 10)
            shieldPart.Transparency = 1 
            shieldPart.CanCollide = true
            shieldPart.Anchored = true
            shieldPart.Parent = workspace
        end
        shieldPart.CFrame = hrp.CFrame * CFrame.Angles(0, 0, math.rad(90))
    end
end)

