local tabs, activeTab = {}, nil
local function createTab(name)
    local tab = {}
    local btn = Instance.new("TextButton", tabsFrame)
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = C.element
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local label = Instance.new("TextLabel", btn)
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = C.textDim
    label.TextSize = 13
    label.Font = Enum.Font.GothamSemibold
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local ind = Instance.new("Frame", btn)
    ind.Size = UDim2.new(0, 3, 0, 16)
    ind.Position = UDim2.new(0, 0, 0.5, -8)
    ind.BackgroundColor3 = C.accent
    ind.BorderSizePixel = 0
    ind.Visible = true
    Instance.new("UICorner", ind).CornerRadius = UDim.new(0, 2)
    
    tab.frame = Instance.new("Frame", contentScroll)
    tab.frame.Size = UDim2.new(1, 0, 1, 0)
    tab.frame.BackgroundTransparency = 1
    tab.frame.Visible = false
    Instance.new("UIListLayout", tab.frame).Padding = UDim.new(0, 8)
    
    tab.btn, tab.indicator, tab.label = btn, ind, label
    
    btn.MouseButton1Click:Connect(function()
        if activeTab == tab then return end
        if activeTab then
            TweenService:Create(activeTab.indicator, TweenInfo.new(0.2), {Position = UDim2.new(0, 0, 0.5, -8), Size = UDim2.new(0, 3, 0, 16)}):Play()
            TweenService:Create(activeTab.label, TweenInfo.new(0.2), {TextColor3 = C.textDim}):Play()
            activeTab.frame.Visible = false
        end
        activeTab = tab
        tab.frame.Visible = true
        TweenService:Create(ind, TweenInfo.new(0.2), {Position = UDim2.new(0, -1, 0.5, -8), Size = UDim2.new(0, 3, 0, 20)}):Play()
        TweenService:Create(label, TweenInfo.new(0.2), {TextColor3 = C.text}):Play()
    end)
    
    btn.MouseEnter:Connect(function() if activeTab ~= tab then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play() end end)
    btn.MouseLeave:Connect(function() if activeTab ~= tab then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play() end end)
    
    tabs[#tabs+1] = tab
    return tab
end

