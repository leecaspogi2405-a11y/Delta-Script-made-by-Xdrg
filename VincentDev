-- 4. Invincible Toggle (Invisible Character: Transparency = 1)
invincibleBtn.MouseButton1Click:Connect(function()
    invincibleOn = not invincibleOn
    invincibleBtn.Text = "Invincible:\n" .. (invincibleOn and "[On]" or "[Off]")

    local char = LocalPlayer.Character
    if not char then return end

    if invincibleOn then
        originalTransparencies = {}
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") then
                originalTransparencies[obj] = obj.Transparency
                obj.Transparency = 1
            end
        end
    else
        for obj, trans in pairs(originalTransparencies) do
            if obj and obj.Parent then
                obj.Transparency = trans
            end
        end
    end
end)

-- 5. Anti Damage Shield (Invisible Anchored Ring Part Around Player)
antiDamageBtn.MouseButton1Click:Connect(function()
    antiDamageOn = not antiDamageOn
    antiDamageBtn.Text = "Anti Damage:\n" .. (antiDamageOn and "[On]" or "[Off]")

    if not antiDamageOn and shieldPart then
        shieldPart:Destroy()
        shieldPart = nil
    end
end)

