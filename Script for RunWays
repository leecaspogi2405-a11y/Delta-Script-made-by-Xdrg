task.spawn(function()
    while true do
        if State.AutoHeal then
            pcall(function()
                local hum = getHumanoid()
                if hum and hum.Health > 0 and hum.Health < hum.MaxHealth * State.HealAt / 100 then
                    local item = findTool(HEAL_KEYWORDS)
                    if item then
                        equipTool(item)
                        task.wait(0.2)
                        Flow.Consumables.Consume(item)
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while true do
        if State.AutoRepair then
            pcall(function()
                local vehicle = getMainVehicle()
                local root = getRoot()
                if vehicle and root then
                    local hp = vehicle:FindFirstChild("vehicleHealth")
                    local vRoot = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                    if hp and hp:IsA("NumberValue") and hp.Value < 100 and vRoot and (vRoot.Position - root.Position).Magnitude <= 30 then
                        local tool = findTool(REPAIR_KEYWORDS)
                        if tool then
                            equipTool(tool)
                            task.wait(0.2)
                            Flow.Repair.RepairVehicle(tool)
                        end
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while true do
        if State.AutoRefuel then
            pcall(function()
                local vehicle = getMainVehicle()
                local root = getRoot()
                if vehicle and root then
                    local vRoot = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                    if vRoot and (vRoot.Position - root.Position).Magnitude <= 20 then
                        local can = findTool(FUEL_KEYWORDS)
                        if can then
                            equipTool(can)
                            task.wait(0.2)
                            Flow.Jerrycan.Pour(can, true)
                            task.wait(1)
                            Flow.Jerrycan.Pour(can, false)
                        end
                    end
                end
            end)
        end
        task.wait(2)
    end
end)

-- ESP
local ESPObjects = {}
local function clearESP(key)
    for obj, owner in pairs(ESPObjects) do
        if owner == key then
            if obj.Parent then obj:Destroy() end
            ESPObjects[obj] = nil
        end
    end
end

local function addHighlight(addee, color, key, labelText)
    local holder = addee:IsA("Model") and (addee.PrimaryPart or addee:FindFirstChildWhichIsA("BasePart")) or addee
    if not holder then return end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.6
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = addee
    highlight.Parent = holder
    ESPObjects[highlight] = key
    if labelText then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.fromOffset(200, 40)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = holder
        bb.Parent = holder
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.fromScale(1, 1)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = color
        tl.TextStrokeTransparency = 0.2
        tl.TextScaled = true
        tl.Font = Enum.Font.GothamBold
        tl.Text = labelText
        tl.Parent = bb
        ESPObjects[bb] = key
        ESPObjects[tl] = key
    end
end

task.spawn(function()
    while true do
        pcall(function()
            if State.LootESP then
                clearESP("Loot")
                local loot = workspace:FindFirstChild("Loot")
                if loot then
                    for _, d in ipairs(loot:GetDescendants()) do
                        if d:IsA("MeshPart") and d.Parent then
                            local price = 0
                            pcall(function() price = LootData.GetItemPrice(d.Parent.Name) or 0 end)
                            addHighlight(d, Color3.fromRGB(255, 215, 0), "Loot", d.Parent.Name .. " $" .. price)
                        end
                    end
                end
            else
                clearESP("Loot")
            end
            if State.NPCESP then
                clearESP("NPC")
                for _, npc in ipairs(CollectionService:GetTagged("NPC")) do
                    local class = classifyNPC(npc)
                    local color = class == "Officer" and Color3.fromRGB(0, 120, 255) or class == "Hostile" and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(60, 255, 60)
                    addHighlight(npc, color, "NPC", npc.Name .. " [" .. class .. "]")
                end
            else
                clearESP("NPC")
            end
            if State.VehicleESP then
                clearESP("Vehicle")
                for _, v in ipairs(workspace.Vehicles:GetChildren()) do
                    addHighlight(v, Color3.fromRGB(170, 90, 255), "Vehicle", v.Name)
                end
            else
                clearESP("Vehicle")
            end
            if State.CashESP then
                clearESP("Cash")
                for _, c in ipairs(CollectionService:GetTagged("Cash")) do
                    addHighlight(c, Color3.fromRGB(60, 255, 60), "Cash", "Cash Drop")
                end
            else
                clearESP("Cash")
            end
        end)
        task.wait(1)
    end
end)

-- TELEPORT
local function getTeleportSpots()
    local spots = {}
    if workspace.SpawnLocation then spots["Spawn"] = CFrame.new(workspace.SpawnLocation.Position + Vector3.new(0, 5, 0)) end
    local seen = {}
    for i, b in ipairs(workspace.Map.Buildings:GetChildren()) do
        if b:IsA("Model") then
            local label = seen[b.Name] and (b.Name .. " " .. i) or b.Name
            seen[b.Name] = true
            spots[label] = b:GetPivot() + Vector3.new(0, 10, 0)
        end
    end
    local veh = getMainVehicle()
    if veh then
        local vp = veh.PrimaryPart or veh:FindFirstChildWhichIsA("BasePart")
        if vp then spots["My Vehicle"] = CFrame.new(vp.Position + Vector3.new(0, 8, 0)) end
    end
    return spots
end

