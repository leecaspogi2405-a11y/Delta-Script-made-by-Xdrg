task.spawn(function()
    while true do
        if State.AutoHeal then
            pcall(function()
                local hum = getHumanoid()
                if hum and hum.Health > 0 and hum.Health < hum.MaxHealth * State.HealAt / 100 then
                    local item = findTool(HEAL_KEYWORDS)
