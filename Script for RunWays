-- ==================== HELPERS ====================
local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local HEAL_KEYWORDS = {"bandage", "medkit", "med kit", "first aid", "health", "painkiller", "adrenaline", "syringe", "food", "snack", "drink", "water", "soda"}
local REPAIR_KEYWORDS = {"repair", "wrench", "toolbox", "tool box", "fix"}
local FUEL_KEYWORDS = {"jerrycan", "jerry can", "gas can", "gascan", "fuel can", "gasoline"}

local function toolMatches(tool, keywords)
    local name = string.lower(tool.Name)
    for _, kw in ipairs(keywords) do
        if string.find(name, kw, 1, true) then
            return true
        end
    end
    return false
end

local function findTool(keywords)
    local char = LocalPlayer.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and toolMatches(t, keywords) then
                return t
            end
        end
    end
    for _, t in ipairs(Backpack:GetChildren()) do
        if t:IsA("Tool") and toolMatches(t, keywords) then
            return t
        end
    end
    return nil
end

local function equipTool(tool)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and tool and tool.Parent ~= char then
        hum:EquipTool(tool)
    end
end

local function getMainVehicle()
    local tagged = CollectionService:GetTagged("MainVehicle")
    if #tagged > 0 then return tagged[1] end
    return workspace.Vehicles:FindFirstChildWhichIsA("Model")
end

local function classifyNPC(model)
    local name = string.lower(model.Name)
    if name:find("officer") or name:find("police") or name:find("cop") or name:find("swat") or name:find("sheriff") then
        return "Officer"
    end
    if model:FindFirstChildOfClass("Tool") then
        return "Hostile"
    end
    local holster = model:FindFirstChild("Holster")
    if holster and #holster:GetChildren() > 0 then
        return "Hostile"
    end
    return "Civilian"
end

local function npcMatchesTarget(classification)
    if State.KillAuraTarget == "All NPCs" then return true end
    if State.KillAuraTarget == "Officers Only" then return classification == "Officer" end
    if State.KillAuraTarget == "Hostile Only" then return classification == "Hostile" end
    if State.KillAuraTarget == "Civilians Only" then return classification == "Civilian" end
    if State.KillAuraTarget == "Hostile & Officers" then return classification ~= "Civilian" end
    return true
end

