task.spawn(function()
    while true do
        if State.InfiniteAmmo then
            pcall(function()
                local char = LocalPlayer.Character
                local containers = {Backpack}
                if char then table.insert(containers, char) end
                for _, container in ipairs(containers) do
                    for _, tool in ipairs(container:GetChildren()) do
                        if tool:IsA("Tool") then
                            local max = tool:GetAttribute("MaxAmmo")
                            if max and tool:GetAttribute("Ammo") ~= max then tool:SetAttribute("Ammo", max) end
                        end
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    while true do
        if State.LootAura then
            pcall(function()
                local root = getRoot()
                local loot = workspace:FindFirstChild("Loot")
                if root and loot then
                    for _, d in ipairs(loot:GetDescendants()) do
                        if d:IsA("MeshPart") and d.Parent then
                            if (d.Position - root.Position).Magnitude <= State.LootRange then
