-- ================= AUTO FARM FUNCTION (Collects ALL Crystals) =================
local function farmAllCrystals()
    if not CrystalPickup then return end
    
    -- Farm ALL crystals in the list
    for _, crystal in ipairs(CrystalList) do
        pcall(function()
            firesignal(CrystalPickup.OnClientEvent, {
                ["success"] = true,
                ["combo"] = false,
                ["broken"] = false,
                ["crystalName"] = crystal.name,
                ["amount"] = math.random(1, 5), -- Random amount for faster farming
                ["damage"] = crystal.damage,
            })
        end)
        task.wait(0.01) -- Tiny delay between signals
    end
end

-- ================= AUTO SELL FUNCTION =================
local function autoSellCrystals()
    local character = LocalPlayer.Character
    if not character then return false end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    -- Find ALL sell prompts
    local sellPrompts = {}
    
    -- Search for ProximityPrompts with sell-related text
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local actionText = (obj.ActionText .. " " .. obj.ObjectText):lower()
            if actionText:find("sell") or actionText:find("trade") or actionText:find("exchange") or actionText:find("cash") or actionText:find("shop") or actionText:find("merchant") or actionText:find("buy") then
                table.insert(sellPrompts, obj)
            end
        end
    end
    
    -- Search for parts/models with sell-related names
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Part") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("sell") or name:find("trade") or name:find("shop") or name:find("merchant") or name:find("vendor") then
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt and not table.find(sellPrompts, prompt) then
                    table.insert(sellPrompts, prompt)
                end
            end
        end
    end
    
    -- Trigger ALL sell prompts found
    local triggeredCount = 0
    for _, prompt in ipairs(sellPrompts) do
        pcall(function()
            fireproximityprompt(prompt)
            triggeredCount = triggeredCount + 1
        end)
    end
    
    if triggeredCount > 0 then
        print("Auto Sell: Triggered " .. triggeredCount .. " sell prompt(s)")
        return true
    else
        -- If no sell prompts found, try to teleport near sell area
        -- Look for any NPC or part with "sell" in name
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Part") and obj.Name:lower():find("sell") then
                if root then
                    root.CFrame = obj.CFrame + Vector3.new(0, 5, 0)
                    task.wait(0.2)
                    -- Try again after teleporting
                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then
                        fireproximityprompt(prompt)
                        return true
                    end
                end
            end
        end
    end
    
    return false
end

