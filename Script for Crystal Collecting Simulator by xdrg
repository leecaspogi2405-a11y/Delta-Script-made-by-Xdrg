-- ================= TELEPORT FUNCTION =================
local function teleportToPrompt(prompt)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    local promptParent = prompt.Parent
    if promptParent then
        local targetPosition = nil
        
        if promptParent:IsA("BasePart") then
            targetPosition = promptParent.Position
        elseif promptParent:IsA("Model") then
            local primaryPart = promptParent.PrimaryPart
            if primaryPart then
                targetPosition = primaryPart.Position
            end
        end
        
        if targetPosition then
            root.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
            return true
        end
    end
    
    return false
end

-- ================= AUTO FARM FUNCTION (Fires ALL Mining ProximityPrompts with Auto Teleport) =================
local function farmAllCrystals()
    -- Fire ALL mining/crystal proximity prompts in the workspace
    local firedPrompts = 0
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local actionText = (obj.ActionText .. " " .. obj.ObjectText):lower()
            
            -- Check for various mining prompt patterns
            local isMiningPrompt = false
            
            -- Check for "mine" variations
            if actionText:find("mine") then
                isMiningPrompt = true
            end
            
            -- Check for crystal mining patterns
            if actionText:find("mine") and (actionText:find("crystal") or actionText:find("rock") or actionText:find("ore") or actionText:find("gem") or actionText:find("acorn") or actionText:find("mushroom") or actionText:find("diamond") or actionText:find("ruby") or actionText:find("emerald") or actionText:find("sapphire") or actionText:find("amethyst") or actionText:find("topaz") or actionText:find("opal") or actionText:find("jade") or actionText:find("quartz") or actionText:find("obsidian")) then
                isMiningPrompt = true
            end
            
            -- Check for crystal name patterns
            if actionText:find("acorn") or actionText:find("rocks") or actionText:find("mushroom") or actionText:find("crystal") then
                if actionText:find("mine") or actionText:find("collect") or actionText:find("gather") or actionText:find("pick") or actionText:find("harvest") or actionText:find("dig") or actionText:find("extract") then
                    isMiningPrompt = true
                end
            end
            
            -- Fire the prompt if it's a mining prompt
            if isMiningPrompt then
                -- Auto teleport to prompt if enabled
                if autoTeleport then
                    teleportToPrompt(obj)
                end
                
                pcall(function()
                    fireproximityprompt(obj)
                    firedPrompts = firedPrompts + 1
                end)
            end
        end
    end
    
    -- Also fire the CrystalPickup remote for all crystals
    if CrystalPickup then
        local CrystalList = {
            "acorn Crystal", "rocks Crystal", "mushroom Crystal",
            "Diamond Crystal", "Ruby Crystal", "Emerald Crystal",
            "Sapphire Crystal", "Amethyst Crystal", "Topaz Crystal",
            "Opal Crystal", "Jade Crystal", "Quartz Crystal",
            "Obsidian Crystal", "Common Crystal", "Uncommon Crystal",
            "Rare Crystal", "Epic Crystal", "Legendary Crystal",
            "Mythic Crystal"
        }
        
        for _, crystalName in ipairs(CrystalList) do
            pcall(function()
                firesignal(CrystalPickup.OnClientEvent, {
                    ["success"] = true,
                    ["combo"] = false,
                    ["broken"] = false,
                    ["crystalName"] = crystalName,
                    ["amount"] = math.random(1, 5),
                    ["damage"] = math.random(10, 100),
                })
            end)
        end
    end
    
    return firedPrompts
end

-- ================= AUTO SELL FUNCTION (Fires ALL Sell Prompts with Auto Teleport) =================
local function autoSellCrystals()
    local firedSellPrompts = 0
    
    -- Fire ALL sell prompts - NO DISTANCE CHECK, INSTANT
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local actionText = (obj.ActionText .. " " .. obj.ObjectText):lower()
            
            -- Check for sell-related keywords
            if actionText:find("sell") or actionText:find("trade") or actionText:find("exchange") or actionText:find("cash") or actionText:find("shop") or actionText:find("merchant") or actionText:find("buy") or actionText:find("vendor") or actionText:find("market") or actionText:find("store") then
                -- Auto teleport to sell prompt if enabled
                if autoTeleport then
                    teleportToPrompt(obj)
                end
                
                pcall(function()
                    fireproximityprompt(obj)
                    firedSellPrompts = firedSellPrompts + 1
                end)
            end
        end
    end
    
    -- Also check for sell parts/models and fire their prompts
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Part") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("sell") or name:find("trade") or name:find("shop") or name:find("merchant") or name:find("vendor") or name:find("market") then
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    -- Auto teleport to sell prompt if enabled
                    if autoTeleport then
                        teleportToPrompt(prompt)
                    end
                    
                    pcall(function()
                        fireproximityprompt(prompt)
                        firedSellPrompts = firedSellPrompts + 1
                    end)
                end
            end
        end
    end
    
    return firedSellPrompts
end

